# ── Сайт ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_channel
# NEXT_PUBLIC_YANDEX_METRIKA_ID=12345678

# ── База данных ──────────────────────────────────────────────────────
# Локально по умолчанию используется встроенный PGlite (файл в ./.data), ничего ставить не нужно.
# DATABASE_URL=pglite:./.data/pglite
# Прод: Yandex Managed Service for PostgreSQL
# DATABASE_URL=postgres://user:password@rc1a-xxxx.mdb.yandexcloud.net:6432/aipm
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."   # корневой сертификат Yandex Cloud
# DB_AUTO_MIGRATE=false

# ── Авторизация (Better Auth) ────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Яндекс ID: https://oauth.yandex.ru — redirect URI: {BETTER_AUTH_URL}/api/auth/callback/yandex
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK ID: https://id.vk.com — redirect URI: {BETTER_AUTH_URL}/api/auth/callback/vk
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# ── Почта (Yandex Cloud Postbox по SMTP) ─────────────────────────────
# Без SMTP_URL письма печатаются в консоль.
# SMTP_URL=smtps://login:password@postbox.cloud.yandex.net:465
# MAIL_FROM="AI PM Academy <no-reply@aipm.academy>"

# ── Генерация и ревью контента (scripts/content) ─────────────────────
# Любой OpenAI-совместимый API. Для ревью — модель другого вендора.
# CONTENT_LLM_BASE_URL=
# CONTENT_LLM_API_KEY=
# CONTENT_LLM_MODEL=
# CONTENT_REVIEW_BASE_URL=https://llm.api.cloud.yandex.net/v1
# CONTENT_REVIEW_API_KEY=
# CONTENT_REVIEW_MODEL=
# CONTENT_PREVIEW=1   # показывать черновики (draft: true)
